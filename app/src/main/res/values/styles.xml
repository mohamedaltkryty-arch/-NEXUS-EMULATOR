<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeDark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8B7CFF</item>
        <item name="android:colorControlHighlight">#338B7CFF</item>
        <item name="android:statusBarColor">#0B1020</item>
        <item name="android:navigationBarColor">#0B1020</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0B1020</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AppThemeLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5D4BE0</item>
        <item name="android:colorControlHighlight">#335D4BE0</item>
        <item name="android:statusBarColor">#F4F6FB</item>
        <item name="android:navigationBarColor">#F4F6FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F6FB</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AppTheme" parent="@style/AppThemeDark" />
</resources>